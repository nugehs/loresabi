{
  "name": "@loresabi/database",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "db:generate": "prisma generate --schema prisma/schema.prisma --config ../../prisma.config.ts",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma --config ../../prisma.config.ts",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma --config ../../prisma.config.ts",
    "db:studio": "prisma studio --schema prisma/schema.prisma --config ../../prisma.config.ts",
    "db:validate": "prisma validate --schema prisma/schema.prisma --config ../../prisma.config.ts",
    "db:seed": "node --env-file=../../.env prisma/seed.mjs",
    "db:clear": "node --env-file=../../.env prisma/clear.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "types": "src/index.ts",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3"
  }
}
