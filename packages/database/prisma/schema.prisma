generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExplainerCategory {
  HISTORY
  CURRENT_AFFAIRS
  POP_CULTURE
  CULTURE
  SYMBOLS
  POLITICS
  ECONOMY
  SPORTS
  FOOD
  LANGUAGE
}

enum ReviewStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum SourceType {
  OFFICIAL
  NEWS
  ENCYCLOPEDIA
  ACADEMIC
  CULTURAL
  SOCIAL
  OTHER
}

enum TrendSource {
  GOOGLE_TRENDS
  NEWS
  SOCIAL
  INTERNAL_SEARCH
  CURATED
}

model User {
  id         String      @id @default(cuid())
  email      String      @unique
  name       String?
  savedItems SavedItem[]
  searches   SearchLog[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Country {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  officialName String?
  iso2         String?     @unique
  iso3         String?     @unique
  region       String?
  subregion    String?
  capital      String?
  demonym      String?
  population   BigInt?
  latitude     Decimal?    @db.Decimal(9, 6)
  longitude    Decimal?    @db.Decimal(9, 6)
  topics       Topic[]
  explainers   Explainer[]
  images       Image[]
  trends       Trend[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([region])
  @@index([name])
}

model Topic {
  id          String      @id @default(cuid())
  slug        String
  title       String
  description String?
  countryId   String
  country     Country     @relation(fields: [countryId], references: [id], onDelete: Cascade)
  explainers  Explainer[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([countryId, slug])
  @@index([title])
}

model Explainer {
  id           String             @id @default(cuid())
  slug         String
  title        String
  summary      String
  body         String
  category     ExplainerCategory
  status       ReviewStatus       @default(DRAFT)
  readingTime  Int?
  countryId    String
  country      Country            @relation(fields: [countryId], references: [id], onDelete: Cascade)
  topicId      String?
  topic        Topic?             @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sources      Source[]
  images       Image[]
  savedItems   SavedItem[]
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([countryId, slug])
  @@index([category])
  @@index([status])
  @@index([publishedAt])
}

model Source {
  id          String     @id @default(cuid())
  title       String
  url         String
  publisher   String?
  type        SourceType @default(OTHER)
  accessedAt  DateTime?
  explainerId String
  explainer   Explainer  @relation(fields: [explainerId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@unique([explainerId, url])
  @@index([type])
}

model Image {
  id          String     @id @default(cuid())
  url         String
  alt         String
  credit      String?
  sourceUrl   String?
  countryId   String?
  country     Country?   @relation(fields: [countryId], references: [id], onDelete: SetNull)
  explainerId String?
  explainer   Explainer? @relation(fields: [explainerId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([countryId])
  @@index([explainerId])
}

model Trend {
  id        String      @id @default(cuid())
  query     String
  source    TrendSource
  score     Int?
  countryId String?
  country   Country?    @relation(fields: [countryId], references: [id], onDelete: SetNull)
  region    String?
  capturedAt DateTime   @default(now())
  createdAt DateTime    @default(now())

  @@index([query])
  @@index([source])
  @@index([countryId])
  @@index([capturedAt])
}

model SearchLog {
  id        String   @id @default(cuid())
  query     String
  locale    String?
  country   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([query])
  @@index([country])
  @@index([createdAt])
}

model SavedItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  explainerId String
  explainer   Explainer @relation(fields: [explainerId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, explainerId])
  @@index([explainerId])
}
