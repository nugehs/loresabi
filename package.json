{
  "name": "loresabi",
  "version": "1.0.0",
  "description": "LoreSabi by Bashbop is a web-first knowledge product for understanding countries through simple explainers, culture, current affairs, pop culture, national symbols, and live curiosity signals.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:web": "npm run dev -w @loresabi/web",
    "dev:api": "npm run dev -w @loresabi/api",
    "build:web": "npm run build -w @loresabi/web",
    "build:api": "npm run build -w @loresabi/api",
    "db:generate": "npm run db:generate -w @loresabi/database",
    "db:migrate": "npm run db:migrate -w @loresabi/database",
    "db:deploy": "npm run db:deploy -w @loresabi/database",
    "db:studio": "npm run db:studio -w @loresabi/database",
    "db:validate": "npm run db:validate -w @loresabi/database",
    "db:seed": "npm run db:seed -w @loresabi/database",
    "db:clear": "npm run db:clear -w @loresabi/database"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nugehs/loresabi.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nugehs/loresabi/issues"
  },
  "homepage": "https://github.com/nugehs/loresabi#readme",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
